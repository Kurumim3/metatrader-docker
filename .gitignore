# =============================================================================
# .gitignore — metatrader-docker
# =============================================================================
# Runtime data generated on the VPS. NEVER commit any of this.
#
# This repo follows "Option A": the only source of truth is
# install-mt-docker.sh. Everything it generates (Dockerfile, compose file,
# scripts/, docker/) is recreated on every run and is therefore ignored.
# =============================================================================

# --- Runtime data (created by the installer on the VPS) -----------------
data/
backups/
robos/

# --- Secrets -------------------------------------------------------------
.env
.env.*
!.env.example

# --- State files written by install-mt-docker.sh -------------------------
# Absolute paths / language chosen on this machine — not portable.
.lang
.robos_dir
.backup_dir

# --- Files generated by the script ---------------------------------------
# The installer regenerates all of these on every run. The repo only ships
# install-mt-docker.sh + docs + configs; everything below is generated.
Dockerfile
docker-compose.yml
.dockerignore
docker/
scripts/

# --- Logs ----------------------------------------------------------------
*.log
logs/

# --- Editor / OS junk ----------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# --- Temporary files -----------------------------------------------------
*.tmp
*.bak
*.pid
*.sock
