# =============================================================================
# .gitignore — metatrader-docker
# =============================================================================
# Runtime data generated on the VPS. NEVER commit any of this.
# =============================================================================

# --- Runtime data (created by the installer on the VPS) -----------------
data/
backups/
robos/

# --- Secrets -------------------------------------------------------------
.env
.env.*
!.env.example

# --- State files written by install-mt-docker.sh -------------------------
# Absolute paths / language chosen on this machine — not portable.
.lang
.robos_dir
.backup_dir

# --- Files generated by the script (only ignored if you DON'T ship them) -
# Uncomment these lines if you keep the source in install-mt-docker.sh
# and let it regenerate everything. Leave them commented if you commit a
# pre-generated copy of these files.
# Dockerfile
# docker-compose.yml
# .dockerignore
# docker/
# scripts/

# --- Logs ----------------------------------------------------------------
*.log
logs/

# --- Editor / OS junk ----------------------------------------------------
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/

# --- Temporary files -----------------------------------------------------
*.tmp
*.bak
*.pid
*.sock
