# =============================================================================
# .gitattributes — enforce Unix (LF) line endings everywhere
# =============================================================================
# This project targets Linux VPS only. Shell scripts and the files the
# installer generates MUST use LF; CRLF breaks them with errors like
# "bash: $'\r': command not found".
#
# With this file in place, cloning from Windows/macOS/Linux always yields
# LF files in the working tree — no need to run:
#     sed -i 's/\r$//' install-mt-docker.sh
# =============================================================================

# Default: detect text files and normalize them to LF in the working tree
* text=auto eol=lf

# Shell scripts and shell-adjacent files: always LF
*.sh            text eol=lf
Dockerfile      text eol=lf
docker-compose.yml text eol=lf
*.conf          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.env           text eol=lf
.env.example    text eol=lf

# Windows-only scripts (if any are ever added): keep CRLF
*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

# Binary files: never normalize
*.exe           binary
*.zip           binary
*.gz            binary
*.tar           binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.ico           binary
