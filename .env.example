# =============================================================================
# .env.example — modelo de configuração
# =============================================================================
# Copie este arquivo para .env e ajuste conforme necessário:
#     cp .env.example .env
#
# NUNCA faça commit do .env (já está no .gitignore).
# =============================================================================

# --- Diretório base na VPS -----------------------------------------------
APP_DIR=/opt/mt-docker

# --- SSH ----------------------------------------------------------------
# Porta SSH da VPS (usada só nas mensagens de acesso). Deixe vazio para
# detecção automática via $SSH_CONNECTION / sshd -T.
SSH_PORT=22

# --- Instaladores da corretora (opcional) -------------------------------
# Se preencher ZIP_URL + ZIP_PASSWORD, o menu 2 (opção "Corretora") baixa
# este ZIP, extrai e usa os .exe de dentro. Se deixar vazio, o menu 2 cai
# automaticamente nos instaladores oficiais da MetaQuotes.
#
# Formato do ZIP: um arquivo .zip protegido por senha contendo, na raiz,
# os dois instaladores (.exe) com os nomes abaixo.
ZIP_URL=
ZIP_PASSWORD=
INSTALADOR_MT4=gomarketsmu4setup.exe
INSTALADOR_MT5=gomarketsmu5setup.exe

# --- Wine ---------------------------------------------------------------
# Versão fixada do Wine. 10.x é a recomendada (o instalador oficial da
# MetaQuotes falha no Wine 11 com "A debugger has been found running").
WINE_VERSION=10.0.0.0~jammy-1
