# =============================================================================
# .env.example — configuration template / modelo de configuração
# =============================================================================
# Copy this file to .env if you want to customize:
#     cp .env.example .env
#
# The script works WITHOUT a .env file (it uses the defaults below).
# NEVER commit your .env (it is already in .gitignore).
#
# After editing, recreate the container so the values take effect:
#     docker compose up -d --force-recreate
# =============================================================================

# --- Base directory on the VPS ------------------------------------------
# Where the project files, prefixes and logs live.
APP_DIR=/opt/mt-docker

# --- SSH ----------------------------------------------------------------
# VPS SSH port (used only in the access messages). Leave empty to
# auto-detect via $SSH_CONNECTION / sshd -T.
SSH_PORT=22

# --- Wine ---------------------------------------------------------------
# Pinned Wine version. 10.x is recommended — the official MetaQuotes
# installer fails on Wine 11 with "A debugger has been found running".
WINE_VERSION=10.0.0.0~jammy-1
# Wine branch: stable | staging | devel
WINE_BRANCH=stable

# --- Container identity -------------------------------------------------
IMAGE_NAME=mt-trader:local
CONTAINER_NAME=mt

# --- Timezone -----------------------------------------------------------
# Any tz database name, e.g. America/Sao_Paulo, UTC, Europe/London.
TZ=America/Sao_Paulo

# --- Network / noVNC ----------------------------------------------------
# Bind address for noVNC. Keep 127.0.0.1 and use an SSH tunnel.
# Change to 0.0.0.0 ONLY if you understand the security risk.
BIND_ADDR=127.0.0.1
NOVNC_PORT=6080

# VNC password (8 characters; x11vnc only uses the first 8).
# Leave empty and setup-host.sh will generate a random one.
VNC_PASSWORD=

# Virtual screen resolution used by Xvfb.
RESOLUTION=1024x600x16

# --- Resource limits ----------------------------------------------------
# These are auto-tuned by setup-host.sh based on your VPS RAM.
# Adjust only if you know what you are doing.
MEM_LIMIT=800m
MEMSWAP_LIMIT=2800m
CPUS=1.0
SHM_SIZE=128m
PIDS_LIMIT=1024

# --- MetaTrader ---------------------------------------------------------
# Wine dependencies installed once per prefix (vcrun2019, corefonts, etc.).
# Space-separated winetricks verbs.
EA_DEPS_MT4="corefonts vcrun2019 winhttp gdiplus msxml6"
EA_DEPS_MT5="corefonts vcrun2019 winhttp gdiplus msxml6"

# MT4 prefix architecture. Keep win64 (win32 breaks 64-bit installers).
MT4_ARCH=win64

# Language for the container's own log messages: en | pt
MT_LANG=en

# --- Folders ------------------------------------------------------------
# Where EAs/indicators/sets and backups live. Leave commented to use the
# default (next to the script / in $APP_DIR).
# ROBOS_DIR=/opt/mt-docker/robos
# BACKUP_DIR=/opt/mt-docker/backups

# --- Backup -------------------------------------------------------------
# How many backups to keep. 0 = never delete (default).
# BACKUP_KEEP=0
