#!/usr/bin/env bash
# =============================================================================
# Silent Terminal Installer Script
# =============================================================================
set -euo pipefail
source /opt/mt/lib/common.sh
COMP="install"

usage() {
  cat <<'USO'
Usage: mt-install mt4|mt5 [--force] [--skip-deps] [--installer PATH]
USO
}

ID="${1:-}"
[[ "$ID" == "-h" || "$ID" == "--help" ]] && { usage; exit 0; }
[[ -n "$ID" ]] || { usage; exit 1; }
shift
FORCE=0; SKIP_DEPS=0; LOCAL_INSTALLER=""
while (($#)); do
  case "$1" in
    --force) FORCE=1 ;;
    --skip-deps) SKIP_DEPS=1 ;;
    --installer) LOCAL_INSTALLER="${2:?}"; shift ;;
    -h|--help) usage; exit 0 ;;
    *) usage; die "$COMP" "Unknown option: $1" ;;
  esac
  shift
done

load_terminal "$ID"

RUNFLAG=/tmp/mt-install.running
if [[ -f "$RUNFLAG" ]] && kill -0 "$(cat "$RUNFLAG")" 2>/dev/null; then
  die "$COMP" "Another installation is already in progress"
fi
echo $$ > "$RUNFLAG"
INSTALLER="/tmp/mt-setup-$ID.exe"
cleanup() {
  rm -f "$RUNFLAG" "$INSTALLER"
  if ! pgrep -fi "${MT_EXE_NAME:-terminal}" >/dev/null 2>&1; then
    WINEPREFIX="${WINEPREFIX:-}" wineserver -k 2>/dev/null || true
  fi
}
trap cleanup EXIT
trap 'log ERROR "$COMP" "Failure at line $LINENO"' ERR

LIMIT="$(mem_limit_mb)"
(( LIMIT >= 600 )) || die "$COMP" "Memory limit (${LIMIT}MB) is below the 600MB threshold"
xdpyinfo -display "$DISPLAY" >/dev/null 2>&1 || die "$COMP" "Display $DISPLAY is unavailable"

if [[ -s "$MT_MARKER" && $FORCE -eq 0 ]]; then
  log INFO "$COMP" "$MT_NAME is already installed: nothing to do"
  exit 0
fi
if (( FORCE )) && pgrep -fi "$MT_EXE_NAME" >/dev/null; then
  die "$COMP" "$MT_NAME is running. Stop it first via: mt-sv stop $ID"
fi

if [[ ! -f "$WINEPREFIX/.mt_prefix_ready" ]]; then
  log INFO "$COMP" "Initializing Wine prefix for $MT_ARCH"
  WINEDLLOVERRIDES="mscoree,mshtml=d;winemenubuilder.exe=d" timeout 300 wineboot --init
  WINEPREFIX="$WINEPREFIX" wineserver -w
  touch "$WINEPREFIX/.mt_prefix_ready"
fi

if (( SKIP_DEPS == 0 )); then
  mkdir -p "$WINEPREFIX/.deps"
  failed=()
  for dep in $MT_DEPS; do
    if [[ -f "$WINEPREFIX/.deps/$dep" ]]; then
      log INFO deps "$dep is already installed"; continue
    fi
    log INFO deps "Installing dependency: $dep"
    if retry 2 10 timeout 2400 winetricks -q "$dep"; then
      touch "$WINEPREFIX/.deps/$dep"
    else
      failed+=("$dep")
      log ERROR deps "Failed to install: $dep"
      log WARN deps "If the Microsoft download URL changed, update WINETRICKS_VERSION in Dockerfile"
    fi
    WINEPREFIX="$WINEPREFIX" wineserver -w || true
  done
  if [[ ! -f "$WINEPREFIX/.deps/win10" ]]; then
    if winetricks -q win10; then touch "$WINEPREFIX/.deps/win10"; fi
    WINEPREFIX="$WINEPREFIX" wineserver -w || true
  fi
  if ((${#failed[@]} > 0)); then
    log WARN deps "Dependencies that failed: ${failed[*]}"
  fi
fi

if [[ -n "$LOCAL_INSTALLER" ]]; then
  [[ -f "$LOCAL_INSTALLER" ]] || die "$COMP" "Installer not found at specified path"
  cp "$LOCAL_INSTALLER" "$INSTALLER"
else
  log INFO "$COMP" "Downloading installer from $MT_URL"
  retry 3 5 wget --timeout=30 --tries=1 -q -O "$INSTALLER" "$MT_URL" || die "$COMP" "Download failed"
fi
verify_installer "$INSTALLER"

log INFO "$COMP" "Executing installer (monitor via noVNC)"
timeout 900 wine "$INSTALLER" /auto >> "$LOG_DIR/setup-$ID.log" 2>&1 &
SETUP_PID=$!
terminal_seen=0
for ((i = 0; i < 180; i++)); do
  if pgrep -fi "$MT_EXE_NAME" >/dev/null; then
    log INFO "$COMP" "Terminal started; waiting 90s for MQL/base file extraction"
    sleep 90
    terminal_seen=1
    break
  fi
  if ! kill -0 "$SETUP_PID" 2>/dev/null; then
    log INFO "$COMP" "Installer exited; waiting for terminal process up to 60s"
    for ((j = 0; j < 12; j++)); do
      if pgrep -fi "$MT_EXE_NAME" >/dev/null; then
        log INFO "$COMP" "Terminal started; waiting 90s for MQL/base file extraction"
        sleep 90
        terminal_seen=1
        break 2
      fi
      sleep 5
    done
    break
  fi
  sleep 5
done
(( terminal_seen )) || log WARN "$COMP" "Terminal process was not detected within timeout"

if kill -0 "$SETUP_PID" 2>/dev/null; then
  kill -TERM "$SETUP_PID" 2>/dev/null || true
  sleep 3
  wait "$SETUP_PID" 2>/dev/null || true
fi

EXE="$(find_exe || true)"
if [[ -z "$EXE" ]]; then
  find "$WINEPREFIX/drive_c" -iname 'terminal*.exe' 2>/dev/null | head -20 >> "$LOG_DIR/setup-$ID.log" || true
  die "$COMP" "$MT_EXE_NAME not found (check $LOG_DIR/setup-$ID.log)"
fi

if pgrep -fi "$MT_EXE_NAME" >/dev/null; then
  log INFO "$COMP" "Closing orphan terminal to transfer process control to supervisord"
  WINEPREFIX="$WINEPREFIX" wine taskkill /IM "$MT_EXE_NAME" 2>/dev/null || true
  for _ in $(seq 1 30); do
    pgrep -fi "$MT_EXE_NAME" >/dev/null || break
    sleep 1
  done
  if pgrep -fi "$MT_EXE_NAME" >/dev/null; then
    WINEPREFIX="$WINEPREFIX" wineserver -k 2>/dev/null || true
    WINEPREFIX="$WINEPREFIX" wineserver -w 2>/dev/null || true
  fi
fi

WINEPREFIX="$WINEPREFIX" wineserver -w 2>/dev/null || true
sleep 2
echo "$EXE" > "$MT_MARKER"
chmod 700 "$WINEPREFIX"
rm -rf "$HOME/.cache/winetricks" "$HOME/.cache/fontconfig"
log INFO "$COMP" "$MT_NAME installed successfully: $EXE (supervisord will launch it within 10s)"
